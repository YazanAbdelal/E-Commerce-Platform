{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@app/contracts": ["./libs/contracts/src/index.ts"],
      "@app/contracts/*": ["./libs/contracts/src/*"],
      "@app/observability": ["./libs/observability/src/index.ts"],
      "@app/observability/*": ["./libs/observability/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/product-catalog-service/tsconfig.app.json"
    },
    {
      "path": "./apps/user-service/tsconfig.app.json"
    },
    {
      "path": "./apps/shopping-cart-service/tsconfig.app.json"
    },

    {
      "path": "./apps/order-service/tsconfig.app.json"
    },
    {
      "path": "./apps/payment-service/tsconfig.app.json"
    }
  ]
}
